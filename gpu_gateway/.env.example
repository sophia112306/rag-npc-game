# The vLLM OpenAI-compatible endpoint on the same GPU host.
VLLM_BASE_URL=http://127.0.0.1:8001/v1

# Adapter selection is based only on the authorized target_context.npc_id.
NPC_MODEL_MAP={"menmesvento":"menmesvento-lora","vidalia":"vidalia-lora"}

# Registered NPCs without a trained adapter use the base model. The player is
# not a registered NPC and is rejected instead of reaching this fallback.
NPC_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_RESPONSE_FORMAT=json_schema
VLLM_UPSTREAM_TIMEOUT_SECONDS=60

# Optional. If set here, configure the same value as MODEL_GATEWAY_API_KEY on
# the game backend. Keep secrets outside Git.
NPC_GATEWAY_API_KEY=
VLLM_API_KEY=
