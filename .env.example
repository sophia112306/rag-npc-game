DATABASE_URL=sqlite+aiosqlite:///./data/game.db
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Leave blank to use deterministic rule-based dynamic dialogue and events.
# contract_http posts the project contract directly to MODEL_GATEWAY_URL.
# openai_compatible posts Chat Completions to MODEL_GATEWAY_URL/chat/completions.
MODEL_GATEWAY_PROVIDER=contract_http
MODEL_GATEWAY_URL=
MODEL_GATEWAY_MODEL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_RESPONSE_FORMAT=json_schema
MODEL_GATEWAY_TIMEOUT_SECONDS=15
MODEL_GATEWAY_MAX_ATTEMPTS=2

# Private GPU service reached through an SSH tunnel; leave blank for reviewed GLB defaults.
HUNYUAN3D_URL=http://127.0.0.1:8081
