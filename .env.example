DATABASE_URL=sqlite+aiosqlite:///./data/game.db
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Leave blank to use deterministic rule-based dynamic dialogue and events.
# For the multi-NPC LoRA gateway, the game backend only needs the /generate URL:
# MODEL_GATEWAY_URL=http://127.0.0.1:8800/generate
# contract_http posts the project contract directly to MODEL_GATEWAY_URL.
# openai_compatible posts Chat Completions to MODEL_GATEWAY_URL/chat/completions.
MODEL_GATEWAY_PROVIDER=contract_http
MODEL_GATEWAY_URL=
# Not used by contract_http; the GPU gateway chooses the adapter from npc_id.
MODEL_GATEWAY_MODEL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_RESPONSE_FORMAT=json_schema
MODEL_GATEWAY_TIMEOUT_SECONDS=15
MODEL_GATEWAY_MAX_ATTEMPTS=2

# Alan's trained LoRA uses a separate plain-dialogue endpoint. When the
# contract gateway above is configured with /generate, this is derived as
# /alan/generate automatically. Override only if hosted elsewhere.
# ALAN_GATEWAY_URL=http://127.0.0.1:8800/alan/generate

# 敘事 AI（規格 v3）：自由對話時先判讀玩家發言、提出數值變化，再讓 NPC 說話。
# contract_http 且 MODEL_GATEWAY_URL 以 /generate 結尾時會自動接到同站的 /narrate；
# 只有部署在不同服務時才需覆寫此值。失敗或逾時時該回合數值變化視為 0。
# NARRATIVE_GATEWAY_URL=http://127.0.0.1:8800/narrate
# NARRATIVE_GATEWAY_TIMEOUT_SECONDS=20
# GPU gateway 端：/narrate 使用的基礎模型（不掛 LoRA），預設同 NPC_FALLBACK_MODEL。
# NARRATOR_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# GPU gateway → vLLM retry budget for transient/invalid model output (1-3).
# VLLM_UPSTREAM_MAX_ATTEMPTS=2

# Semantic-review audit is OFF unless both values are explicitly configured.
# The file contains player dialogue plus NPC-private review context; keep it in
# the private log volume, never in Git, and use a secret with 16+ characters.
# NPC_REVIEW_AUDIT_PATH=/var/log/rag-npc/review-audit.jsonl
# NPC_REVIEW_AUDIT_HMAC_KEY=replace-with-a-secret-retention-key

# Private GPU service reached through an SSH tunnel; leave blank for reviewed GLB defaults.
HUNYUAN3D_URL=http://127.0.0.1:8081
